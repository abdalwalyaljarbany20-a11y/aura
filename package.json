{
  "name": "aura-vision",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time hand tracking and gesture interaction with a 3D robot companion. Runs locally in the browser.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs --check",
    "dev": "vite",
    "start": "npm run dev",
    "build": "node scripts/setup-assets.mjs --check && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "setup:python": "node scripts/py.mjs setup",
    "backend": "node scripts/py.mjs -m aura_cv",
    "dev:python": "node scripts/dev-python.mjs",
    "test:py": "node scripts/py.mjs -m pytest",
    "test:all": "npm test && npm run test:py",
    "bench:python": "node scripts/py.mjs -m aura_cv --benchmark 20",
    "agent:smoke": "node scripts/agent-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
