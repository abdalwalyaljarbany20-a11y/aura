# AURA VISION AI agent - server-side configuration.
# Copy to .env.local (git-ignored) and fill in. These values are read only by the
# local Vite server process (dev / preview); none of them reach browser code.

# Provider (only "anthropic" is implemented)
AURA_AGENT_PROVIDER=anthropic

# Your Claude API key. Leave empty to run the app without the agent.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# AURA_AGENT_MODEL=claude-opus-5-5
# AURA_AGENT_EFFORT=low
# AURA_AGENT_TIMEOUT_MS=30000
# AURA_AGENT_MAX_TOKENS=16000
# AURA_AGENT_BASE_URL=
# Server-side refusal fallback: off (default) or "default". When on, a request the
# model's safety classifier declines is re-run on a fallback model and billed at
# that model's rates (see docs/AGENT_SETUP.md). Leave off unless you want that.
# AURA_AGENT_REFUSAL_FALLBACK=off
